# Flask session signing key (required for logins). Use a long random value;
# generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# Set to True only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=False

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL_ADDRESS@gmail.com
SMTP_PASSWORD=YOUR_16_CHARACTER_PASSWORD
SMTP_FROM=YOUR_EMAIL_ADDRESS@gmail.com
SMTP_USE_TLS=True